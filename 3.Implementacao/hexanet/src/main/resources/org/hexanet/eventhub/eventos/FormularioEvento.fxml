<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="720.0" prefWidth="1080.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.hexanet.eventhub.controller.EventoController">
   <stylesheets>
      <URL value="@../styles.css" />
   </stylesheets>
   <children>
      <VBox alignment="CENTER" spacing="20.0" styleClass="card" maxWidth="450.0" maxHeight="550.0" prefWidth="450.0">
         <children>
            <VBox alignment="CENTER" spacing="5.0">
               <children>
                  <Label fx:id="lblTituloForm" styleClass="label-title" text="Novo Evento" />
                  <Label styleClass="label-subtitle" text="Preencha os dados do evento." />
               </children>
            </VBox>

            <GridPane hgap="10.0" vgap="15.0" alignment="CENTER">
               <columnConstraints>
                  <ColumnConstraints halignment="RIGHT" minWidth="100.0" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
               </columnConstraints>

               <Label text="Nome:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
               <TextField fx:id="tfNome" GridPane.columnIndex="1" GridPane.rowIndex="0" />

               <Label text="Local:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
               <TextField fx:id="tfLocal" GridPane.columnIndex="1" GridPane.rowIndex="1" />

               <Label text="Capacidade:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
               <TextField fx:id="tfCapacidade" GridPane.columnIndex="1" GridPane.rowIndex="2" />

               <Label text="Data:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
               <DatePicker fx:id="dpData" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />

               <Label text="Valor (R$):" GridPane.columnIndex="0" GridPane.rowIndex="4" />
               <TextField fx:id="tfValorIngresso" GridPane.columnIndex="1" GridPane.rowIndex="4" />

               <Label text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
               <ComboBox fx:id="cbStatus" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            </GridPane>

            <HBox alignment="CENTER" spacing="15.0" prefWidth="350.0">
               <children>
                  <Button mnemonicParsing="false" styleClass="button-secondary" onAction="#irParaGerenciar" text="Cancelar" prefWidth="150.0" />
                  <Button mnemonicParsing="false" onAction="#salvarEvento" text="Salvar" prefWidth="150.0" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>
