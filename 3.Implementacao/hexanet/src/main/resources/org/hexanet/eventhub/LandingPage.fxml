<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<HBox alignment="CENTER" spacing="80.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.hexanet.eventhub.controller.LandingPageController">
    <padding>
        <Insets bottom="60.0" left="100.0" right="100.0" top="60.0" />
    </padding>
    <children>

        <VBox alignment="CENTER_LEFT" maxWidth="500.0" spacing="30.0" HBox.hgrow="NEVER">
            <children>
                <Label style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-text-fill: #1E3A8A;" text="Bem-vindo ao EventHub!" wrapText="true" />

                <Label style="-fx-font-size: 18px; -fx-text-fill: #6B7280; -fx-line-spacing: 0.3em;" text="A sua plataforma definitiva para descobrir e gerenciar os melhores eventos. Simples, rápida e feita para si." wrapText="true" />

                <Region VBox.vgrow="ALWAYS" />

                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#irParaLogin" style="-fx-background-color: #FFFFFF; -fx-text-fill: #1E3A8A; -fx-border-color: #1E3A8A; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 12 30 12 30; -fx-cursor: hand;" text="Login" />

                        <Button mnemonicParsing="false" onAction="#irParaEventos" style="-fx-background-color: #F97316; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 12 30 12 30; -fx-background-radius: 8; -fx-cursor: hand;" text="Ver eventos" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <VBox alignment="CENTER" style="-fx-background-color: #F8FAFC; -fx-background-radius: 24; -fx-border-color: #E2E8F0; -fx-border-radius: 24; -fx-border-width: 1;" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="80.0" left="80.0" right="80.0" top="80.0" />
            </padding>
            <children>
                <ImageView fitWidth="350.0" preserveRatio="true">
                    <image>
                        <Image url="@../../../assets/logoEventHub2.png" />
                    </image>
                </ImageView>
            </children>
        </VBox>

    </children>
</HBox>
