<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="720.0" prefWidth="1080.0" style="-fx-background-color: #F3F4F6;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.hexanet.eventhub.controller.EventoController">
    <stylesheets>
        <URL value="@../styles.css" />
    </stylesheets>
    
    <!-- Top Navigation Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #FFFFFF; -fx-padding: 15 30 15 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <children>
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #F97316;" text="EventHub" />
                <Region HBox.hgrow="ALWAYS" />
                
                <!-- Search Bar -->
                <HBox alignment="CENTER" spacing="5.0" style="-fx-background-color: #F3F4F6; -fx-background-radius: 20; -fx-padding: 5 15 5 15;">
                    <children>
                        <TextField promptText="Pesquisar eventos..." style="-fx-background-color: transparent; -fx-pref-width: 250px;" />
                        <Button text="🔍" style="-fx-background-color: transparent; -fx-text-fill: #1E3A8A; -fx-cursor: hand;" />
                    </children>
                </HBox>
                
                <Region HBox.hgrow="ALWAYS" />
                
                <!-- Menu Actions -->
                <HBox alignment="CENTER" spacing="15.0">
                    <children>
                        <!-- Simulation of Menu (will be dynamic in real code, but mocked here) -->
                        <Button mnemonicParsing="false" styleClass="button-secondary" text="Login / Cadastrar" />
                        <Button mnemonicParsing="false" styleClass="button-secondary" text="Meu Perfil" />
                        <Button mnemonicParsing="false" styleClass="button-secondary" text="Meus Eventos" />
                    </children>
                </HBox>
            </children>
        </HBox>
    </top>
    
    <!-- Organic List of Events -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 20;">
            <content>
                <VBox alignment="TOP_CENTER" spacing="20.0">
                    <padding>
                        <Insets top="20" right="50" bottom="20" left="50" />
                    </padding>
                    <children>
                        <Label styleClass="label-title" text="Eventos em Destaque" />
                        
                        <!-- Event Card Mock 1 -->
                        <HBox spacing="20.0" styleClass="card" style="-fx-background-radius: 12; -fx-padding: 15; -fx-cursor: hand;" maxWidth="900.0" prefWidth="900.0">
                            <children>
                                <!-- Event Image (Perfect Cover via CSS) -->
                                <Region prefHeight="150.0" prefWidth="250.0" minWidth="250.0" styleClass="image-rodeio" style="-fx-background-radius: 8;" />
                                
                                <!-- Event Details -->
                                <VBox spacing="10.0" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                                    <children>
                                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E3A8A;" text="Festa Junina Foxes" />
                                        <Label style="-fx-text-fill: #4B5563;" text="Parque da Cidade | 24 de Junho, 18:00" />
                                        <Label style="-fx-text-fill: #6B7280; -fx-wrap-text: true;" text="A maior festa junina da região com comidas típicas, quadrilha, e muita música ao vivo!" />
                                        <Region VBox.vgrow="ALWAYS" />
                                        <HBox alignment="BOTTOM_LEFT" spacing="15.0">
                                            <children>
                                                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #10B981;" text="A partir de R$ 50,00" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Button mnemonicParsing="false" text="Comprar Ingresso" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                        
                        <!-- Event Card Mock 2 -->
                        <HBox spacing="20.0" styleClass="card" style="-fx-background-radius: 12; -fx-padding: 15; -fx-cursor: hand;" maxWidth="900.0" prefWidth="900.0">
                            <children>
                                <!-- Event Image (Perfect Cover via CSS) -->
                                <Region prefHeight="150.0" prefWidth="250.0" minWidth="250.0" styleClass="image-rodeio" style="-fx-background-radius: 8;" />
                                <VBox spacing="10.0" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                                    <children>
                                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E3A8A;" text="Tech Summit 2026" />
                                        <Label style="-fx-text-fill: #4B5563;" text="Centro de Convenções | 10 de Agosto, 09:00" />
                                        <Label style="-fx-text-fill: #6B7280; -fx-wrap-text: true;" text="O maior evento de tecnologia e inovação, com palestrantes internacionais e workshops práticos." />
                                        <Region VBox.vgrow="ALWAYS" />
                                        <HBox alignment="BOTTOM_LEFT" spacing="15.0">
                                            <children>
                                                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #10B981;" text="A partir de R$ 120,00" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Button mnemonicParsing="false" text="Comprar Ingresso" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                        
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
