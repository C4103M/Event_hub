<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" style="-fx-background-color: #F3F4F6;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.hexanet.eventhub.controller.EventoController">
    <stylesheets>
        <URL value="@../styles.css" />
    </stylesheets>
    
    <content>
        <VBox alignment="TOP_CENTER" spacing="0.0">
            <children>
                
                <!-- Top Banner (Perfect Cover via CSS) -->
                <Region prefHeight="300.0" prefWidth="1080.0" styleClass="image-rodeio" />
                
                <!-- Main Content Area -->
                <HBox alignment="TOP_CENTER" fillHeight="false" maxWidth="1000.0" prefWidth="1000.0" spacing="40.0">
                    <padding>
                        <Insets bottom="50" left="20" right="20" top="30" />
                    </padding>
                    
                    <children>
                        <!-- Left Side: Event Details -->
                        <VBox prefWidth="450.0" spacing="20.0" style="-fx-background-radius: 12; -fx-padding: 25;" styleClass="card">
                            <children>
                                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1E3A8A;" text="Festa Junina Foxes" />
                                
                                <VBox spacing="10.0">
                                    <children>
                                        <Label style="-fx-text-fill: #4B5563; -fx-font-size: 16px;" text="Centro de Eventos, São Paulo, SP" />
                                        <Label style="-fx-text-fill: #4B5563; -fx-font-size: 16px;" text="24 de Junho de 2026" />
                                        <Label style="-fx-text-fill: #4B5563; -fx-font-size: 16px;" text="Abertura dos portões: 18:00" />
                                    </children>
                                </VBox>
                                
                                <Separator />
                                
                                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E3A8A;" text="Sobre o Evento" />
                                <Label style="-fx-text-fill: #6B7280; -fx-wrap-text: true; -fx-font-size: 14px;" text="A maior festa junina universitária está de volta! Prepare-se para muita comida típica, brincadeiras, fogueira e atrações musicais incríveis que vão animar a noite toda. Não perca!" />
                            </children>
                        </VBox>
                        
                        <!-- Right Side: Tickets -->
                        <VBox prefWidth="500.0" spacing="15.0" style="-fx-background-radius: 12; -fx-padding: 25;" styleClass="card">
                            <children>
                                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E3A8A;" text="Ingressos" />
                                
                                <!-- Ticket Option 1 -->
                                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-padding: 15; -fx-background-color: #FFFFFF; -fx-background-radius: 8;">
                                    <children>
                                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Entrada Normal" />
                                                <Label style="-fx-font-size: 14px; -fx-text-fill: #6B7280;" text="Lote 1" />
                                                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #10B981;" text="R$ 50,00" />
                                            </children>
                                        </VBox>
                                        <RadioButton mnemonicParsing="false" />
                                    </children>
                                </HBox>
                                
                                <!-- Ticket Option 2 -->
                                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-padding: 15; -fx-background-color: #FFFFFF; -fx-background-radius: 8;">
                                    <children>
                                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Open Food" />
                                                <Label style="-fx-font-size: 14px; -fx-text-fill: #6B7280;" text="Acesso à área de alimentação liberada." />
                                                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #10B981;" text="R$ 120,00" />
                                            </children>
                                        </VBox>
                                        <RadioButton mnemonicParsing="false" />
                                    </children>
                                </HBox>
                                
                                <!-- Ticket Option 3 -->
                                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-padding: 15; -fx-background-color: #FFFFFF; -fx-background-radius: 8;">
                                    <children>
                                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Open Bar + Open Food" />
                                                <Label style="-fx-font-size: 14px; -fx-text-fill: #6B7280;" text="Experiência VIP completa." />
                                                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #10B981;" text="R$ 250,00" />
                                            </children>
                                        </VBox>
                                        <RadioButton mnemonicParsing="false" />
                                    </children>
                                </HBox>
                                
                                <Region VBox.vgrow="ALWAYS" />
                                
                                <Button mnemonicParsing="false" prefWidth="500.0" style="-fx-font-size: 16px; -fx-padding: 12;" text="Comprar Ingresso" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
