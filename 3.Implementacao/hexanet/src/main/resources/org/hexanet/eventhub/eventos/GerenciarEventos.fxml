<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="720.0" prefWidth="1080.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.hexanet.eventhub.controller.EventoController">
    <stylesheets>
        <URL value="@../styles.css" />
    </stylesheets>
    <children>
        <VBox alignment="TOP_CENTER" spacing="20.0" styleClass="card" maxWidth="900.0" maxHeight="600.0" prefWidth="900.0" prefHeight="600.0">
            <children>
                <VBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Label styleClass="label-title" text="Gerenciar Eventos" />
                        <Label styleClass="label-subtitle" text="Administre os eventos que você organiza." />
                    </children>
                </VBox>

                <TableView fx:id="tabelaEventos" prefHeight="400.0" prefWidth="850.0" style="-fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8;">
                    <columns>
                        <TableColumn fx:id="colNome" prefWidth="250.0" text="Nome do Evento" />
                        <TableColumn fx:id="colLocal" prefWidth="200.0" text="Local" />
                        <TableColumn fx:id="colData" prefWidth="150.0" text="Data/Hora" />
                        <TableColumn fx:id="colPreco" prefWidth="120.0" text="Valor (R$)" />
                        <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
                    </columns>
                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="15.0" prefWidth="850.0">
                    <children>
<!--                        <Button mnemonicParsing="false" styleClass="button-secondary" onAction="#excluirEvento" text="Excluir" />-->
<!--                        <Button mnemonicParsing="false" styleClass="button-secondary" onAction="#editarEvento" text="Editar" />-->
<!--                        <Button mnemonicParsing="false" onAction="#novoEvento" text="Novo Evento" />-->
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
