<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" fx:id="mainContainer"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.hexanet.eventhub.controller.MainController"
            prefHeight="720.0" prefWidth="1080.0">
    <stylesheets>
        <URL value="@./styles.css" />
    </stylesheets>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #FFFFFF; -fx-padding: 15 30 15 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <children>
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #F97316; -fx-cursor: hand;"
                       text="EventHub" onMouseClicked="#irParaInicio" />

                <Region HBox.hgrow="ALWAYS" />

                <HBox fx:id="barraPesquisa" alignment="CENTER" spacing="5.0" style="-fx-background-color: #F3F4F6; -fx-background-radius: 20; -fx-padding: 5 15 5 15;">
                    <children>
                        <TextField promptText="Pesquisar eventos..." style="-fx-background-color: transparent; -fx-pref-width: 250px;" />
                        <Button text="🔍" style="-fx-background-color: transparent; -fx-text-fill: #1E3A8A; -fx-cursor: hand;" />
                    </children>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <HBox fx:id="menuDeslogado" alignment="CENTER" spacing="15.0">
                    <children>
                        <Button styleClass="button-secondary" text="Login / Cadastrar" onAction="#irParaLogin" />
                    </children>
                </HBox>

                <HBox fx:id="menuLogado" alignment="CENTER" spacing="15.0" visible="false" managed="false">
                    <children>
                        <Label fx:id="lblSaudacao" style="-fx-font-weight: bold; -fx-text-fill: #1E3A8A;" text="Olá, Usuário" />

                        <Button fx:id="btnGerenciarEventos" styleClass="button-secondary" text="Gerenciar Eventos" onAction="#irParaGerenciarEventos" />

                        <Button fx:id="btnGerenciarPerfil" styleClass="button-secondary" text="Gerenciar Perfil" onAction="#irParaGerenciarPerfil" />

                        <Button styleClass="button-secondary" text="Sair" onAction="#fazerLogout" />
                    </children>
                </HBox>
            </children>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contentArea" />
    </center>
</BorderPane>