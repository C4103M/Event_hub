<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="mainContainer" prefHeight="720.0" prefWidth="1080.0" style="-fx-padding: 0; -fx-margin: 0;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.hexanet.eventhub.controller.MainController">
    <stylesheets>
        <URL value="@./styles.css" />
    </stylesheets>

    <top>
        <VBox style="-fx-background-color: #FFFFFF; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-padding: 15 30 15 30;">
                    <children>
                        <!-- Logo -->
                        <Label onMouseClicked="#irParaInicio" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #F97316; -fx-cursor: hand;" text="EventHub" />
                        
                        <!-- Spacer (Empurra pesquisa e menus) -->
                        <Region HBox.hgrow="ALWAYS" />
                        
                        <!-- Barra de Pesquisa -->
                        <HBox fx:id="barraPesquisa" alignment="CENTER" spacing="5.0" style="-fx-background-color: #F3F4F6; -fx-background-radius: 20; -fx-padding: 5 15 5 15;">
                            <children>
                                <TextField promptText="Pesquisar eventos..." style="-fx-background-color: transparent; -fx-pref-width: 250px;" />
                                <Button style="-fx-background-color: transparent; -fx-text-fill: #1E3A8A; -fx-cursor: hand;" text="🔍" />
                            </children>
                        </HBox>
                        
                        <!-- Spacer -->
                        <Region HBox.hgrow="ALWAYS" />
                        
                        <!-- Menu Deslogado -->
                        <HBox fx:id="menuDeslogado" alignment="CENTER" spacing="15.0">
                            <children>
                                <Button onAction="#irParaLogin" styleClass="button-secondary" text="Login / Cadastrar" />
                            </children>
                        </HBox>
                        
                        <!-- Menu Logado -->
                        <HBox fx:id="menuLogado" alignment="CENTER" managed="false" spacing="15.0" visible="false">
                            <children>
                                <Label fx:id="lblSaudacao" style="-fx-font-weight: bold; -fx-text-fill: #1E3A8A;" text="Olá, Usuário" />
                                <Button fx:id="btnGerenciarEventos" onAction="#irParaGerenciarEventos" styleClass="button-secondary" text="Gerenciar Eventos" />
                                <Button fx:id="btnGerenciarPerfil" onAction="#irParaGerenciarPerfil" styleClass="button-secondary" text="Gerenciar Perfil" />
                                <Button fx:id="btnMeusPedidos" onAction="#irParaMeusPedidos" styleClass="button-secondary" text="Meus Pedidos" />
                                <Button onAction="#fazerLogout" styleClass="button-secondary" text="Sair" />
                            </children>
                        </HBox>
                    </children>
                </HBox>
                
                <!-- Barra de Voltar Premium -->
                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #F9FAFB; -fx-padding: 8 30 8 30; -fx-border-color: #E5E7EB; -fx-border-width: 1 0 1 0;">
                    <children>
                        <Button mnemonicParsing="false" onAction="#voltar" style="-fx-background-color: #F97316; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold; -fx-background-radius: 50em; -fx-min-width: 30px; -fx-min-height: 30px; -fx-max-width: 30px; -fx-max-height: 30px; -fx-padding: 0;" text="&lt;-">
                     <graphic>
                        <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../../assets/seta.png" />
                           </image>
                        </ImageView>
                     </graphic></Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <StackPane fx:id="contentArea" />
    </center>
</BorderPane>
