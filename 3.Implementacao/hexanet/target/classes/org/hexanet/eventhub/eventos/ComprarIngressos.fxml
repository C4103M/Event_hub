<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="720.0" prefWidth="1080.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.hexanet.eventhub.controller.EventoController">
   <stylesheets>
      <URL value="@../styles.css" />
   </stylesheets>
   <children>
      <VBox alignment="TOP_CENTER" spacing="20.0" styleClass="card" maxWidth="900.0" maxHeight="600.0" prefWidth="900.0" prefHeight="600.0">
         <children>
            <VBox alignment="CENTER" spacing="5.0">
               <children>
                  <Label styleClass="label-title" text="Vitrine de Eventos" />
                  <Label styleClass="label-subtitle" text="Selecione um evento para comprar seu ingresso." />
               </children>
            </VBox>

            <ListView fx:id="listVitrineEventos" prefHeight="400.0" prefWidth="850.0" style="-fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8;" />

            <HBox alignment="CENTER" spacing="15.0" prefWidth="850.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#irParaComprarIngressoSelecionado" text="Comprar Ingresso" prefWidth="300.0" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>
