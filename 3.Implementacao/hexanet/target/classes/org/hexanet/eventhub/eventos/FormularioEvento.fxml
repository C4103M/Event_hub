<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<StackPane xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.hexanet.eventhub.controller.EventoController"
           style="-fx-background-color: linear-gradient(to right, #B15B86, #440F50);"
           minWidth="480" minHeight="600">

   <VBox prefWidth="400.0" maxWidth="400.0" maxHeight="680.0" spacing="0"
         style="-fx-background-color: white;
                 -fx-background-radius: 20;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 24, 0, 0, 6);">

      <!-- Header -->
      <VBox style="-fx-background-color: #1a1a2e; -fx-background-radius: 20 20 0 0;">
         <padding><Insets top="28" right="32" bottom="28" left="32"/></padding>
         <Label text="FORMULÁRIO"
                style="-fx-text-fill: #e8a87c; -fx-font-size: 10px;
                          -fx-font-family: 'Segoe UI'; -fx-letter-spacing: 3;"/>
         <Label text="Cadastrar evento"
                style="-fx-text-fill: white; -fx-font-size: 26px;
                          -fx-font-family: 'Georgia'; -fx-font-weight: bold;"/>
      </VBox>

      <!-- Corpo -->
      <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 0 0 20 20;">
         <padding><Insets top="24" right="32" bottom="32" left="32"/></padding>

         <!-- Nome do Evento -->
         <VBox spacing="4">
            <Label text="NOME DO EVENTO"
                   style="-fx-font-size: 10px; -fx-text-fill: #888; -fx-letter-spacing: 1.5;"/>
            <TextField fx:id="txtNomeEvento" promptText="Ex: Festival de Verão"
                       style="-fx-background-color: #f5f4f0; -fx-background-radius: 10;
                                  -fx-border-color: transparent; -fx-pref-height: 40;
                                  -fx-padding: 0 12; -fx-font-size: 13px;"/>
         </VBox>

         <!-- Data + Horário -->
         <HBox spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
               <Label text="DATA"
                      style="-fx-font-size: 10px; -fx-text-fill: #888; -fx-letter-spacing: 1.5;"/>
               <DatePicker fx:id="dgvDataEvento" maxWidth="Infinity"
                           style="-fx-background-color: #f5f4f0; -fx-background-radius: 10;
                                       -fx-border-color: transparent; -fx-pref-height: 40;
                                       -fx-font-size: 13px;"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
               <Label text="HORÁRIO"
                      style="-fx-font-size: 10px; -fx-text-fill: #888; -fx-letter-spacing: 1.5;"/>
               <TextField fx:id="txtHorarioEvento" promptText="00:00" maxWidth="Infinity"
                          style="-fx-background-color: #f5f4f0; -fx-background-radius: 10;
                                      -fx-border-color: transparent; -fx-pref-height: 40;
                                      -fx-padding: 0 12; -fx-font-size: 13px;"/>
            </VBox>
         </HBox>

         <!-- Local -->
         <VBox spacing="4">
            <Label text="LOCAL"
                   style="-fx-font-size: 10px; -fx-text-fill: #888; -fx-letter-spacing: 1.5;"/>
            <TextField fx:id="txtLovalEvento" promptText="Ex: Parque Ibirapuera, São Paulo"
                       style="-fx-background-color: #f5f4f0; -fx-background-radius: 10;
                                  -fx-border-color: transparent; -fx-pref-height: 40;
                                  -fx-padding: 0 12; -fx-font-size: 13px;"/>
         </VBox>

         <!-- Capacidade + Valor do Ingresso -->
         <!-- Capacidade + Quantidade de Ingressos -->
         <HBox spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
               <Label text="CAPACIDADE TOTAL DO EVENTO"
                      style="-fx-font-size: 10px; -fx-text-fill: #888; -fx-letter-spacing: 1.5;"/>
               <TextField fx:id="txtCapacidadeEvento" promptText="Ex: 500" maxWidth="Infinity"
                          style="-fx-background-color: #f5f4f0; -fx-background-radius: 10;
                          -fx-border-color: transparent; -fx-pref-height: 40;
                          -fx-padding: 0 12; -fx-font-size: 13px;"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
               <Label text="QTD. INGRESSOS DISPONIVEIS"
                      style="-fx-font-size: 10px; -fx-text-fill: #888; -fx-letter-spacing: 1.5;"/>
               <TextField fx:id="txtQuantidadeIngressos" promptText="Ex: 200" maxWidth="Infinity"
                          style="-fx-background-color: #f5f4f0; -fx-background-radius: 10;
                          -fx-border-color: transparent; -fx-pref-height: 40;
                          -fx-padding: 0 12; -fx-font-size: 13px;"/>
            </VBox>
         </HBox>

         <!-- Valor do Ingresso -->
         <VBox spacing="4">
            <Label text="VALOR DO INGRESSO"
                   style="-fx-font-size: 10px; -fx-text-fill: #888; -fx-letter-spacing: 1.5;"/>
            <TextField fx:id="txtValorIngresso" promptText="R$ 0,00"
                       style="-fx-background-color: #f5f4f0; -fx-background-radius: 10;
                      -fx-border-color: transparent; -fx-pref-height: 40;
                      -fx-padding: 0 12; -fx-font-size: 13px;"/>
         </VBox>

         <!-- Banner do Evento -->
         <VBox spacing="4">
            <Label text="BANNER DO EVENTO"
                   style="-fx-font-size: 10px; -fx-text-fill: #888; -fx-letter-spacing: 1.5;"/>
            <ComboBox fx:id="cbxBannerEvento" maxWidth="Infinity"
                      style="-fx-background-color: #f5f4f0; -fx-background-radius: 10;
                                 -fx-border-color: transparent; -fx-pref-height: 40;
                                 -fx-font-size: 13px;"/>
         </VBox>

         <!-- Botão Cadastrar -->
         <Button fx:id="btnCadastrarEvento" text="CADASTRAR EVENTO" onAction="#cadastrarEvento"
                 maxWidth="Infinity" prefHeight="44.0"
                 style="-fx-background-color: #1a1a2e; -fx-text-fill: white;
                           -fx-background-radius: 10; -fx-font-size: 12px;
                           -fx-letter-spacing: 2; -fx-cursor: hand;">
            <VBox.margin><Insets top="6"/></VBox.margin>
         </Button>

         <!-- Botão Cancelar -->
         <Button text="Cancelar" onAction="#cancelar"
                 maxWidth="Infinity" prefHeight="40.0"
                 style="-fx-background-color: transparent; -fx-border-color: #ddd;
                           -fx-border-radius: 10; -fx-background-radius: 10;
                           -fx-text-fill: #666; -fx-font-size: 12px; -fx-cursor: hand;"/>
      </VBox>
   </VBox>

</StackPane>