<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="mainContainer" prefHeight="720.0" prefWidth="1080.0" style="-fx-padding: 0; -fx-margin: 0;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.hexanet.eventhub.controller.MainController">
    <stylesheets>
        <URL value="@./styles.css" />
    </stylesheets>

    <top>
        <VBox alignment="CENTER_LEFT" style="-fx-background-color: #FFFFFF; -fx-padding: 15 30 15 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <children>
                <Group>
                    <children>
                        <Label layoutX="156.0" layoutY="45.0" onMouseClicked="#irParaInicio" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #F97316; -fx-cursor: hand;" text="EventHub" />

                        <Region layoutX="273.0" layoutY="34.0" />

                        <HBox fx:id="barraPesquisa" alignment="CENTER" layoutX="345.0" layoutY="34.0" spacing="5.0" style="-fx-background-color: #F3F4F6; -fx-background-radius: 20; -fx-padding: 5 15 5 15;">
                            <children>
                                <TextField promptText="Pesquisar eventos..." style="-fx-background-color: transparent; -fx-pref-width: 250px;" />
                                <Button style="-fx-background-color: transparent; -fx-text-fill: #1E3A8A; -fx-cursor: hand;" text="🔍" />
                            </children>
                        </HBox>

                        <Region layoutX="712.0" layoutY="34.0" />

                        <HBox fx:id="menuDeslogado" alignment="CENTER" layoutX="784.0" layoutY="34.0" spacing="15.0">
                            <children>
                                <Button onAction="#irParaLogin" styleClass="button-secondary" text="Login / Cadastrar" />
                            </children>
                        </HBox>

                        <HBox fx:id="menuLogado" alignment="CENTER" layoutX="112.0" layoutY="19.0" managed="false" spacing="15.0" visible="false">
                            <children>
                                <Label fx:id="lblSaudacao" style="-fx-font-weight: bold; -fx-text-fill: #1E3A8A;" text="Olá, Usuário" />

                                <Button fx:id="btnGerenciarEventos" onAction="#irParaGerenciarEventos" styleClass="button-secondary" text="Gerenciar Eventos" />

                                <Button fx:id="btnGerenciarPerfil" onAction="#irParaGerenciarPerfil" styleClass="button-secondary" text="Gerenciar Perfil" />

                                <Button onAction="#fazerLogout" styleClass="button-secondary" text="Sair" />
                            </children>
                        </HBox>
                    </children>
                </Group>
                <Pane prefHeight="30.0" prefWidth="1020.0" style="-fx-background-color: #E5E7EB;">
                    <children>
                        <Button mnemonicParsing="false" onAction="#voltar" style="-fx-background-radius: 50em; -fx-min-width: 30px; -fx-min-height: 30px; -fx-max-width: 30px; -fx-max-height: 30px; -fx-padding: 0;" text="&lt;-" />
                    </children>
                </Pane>
            </children>
        </VBox>

    </top>

    <center>
        <StackPane fx:id="contentArea" />
    </center>
</BorderPane>
