<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">

    <persistence-unit name="ev-hub">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>org.hexanet.eventhub.model.Evento</class>
        <class>org.hexanet.eventhub.model.Ingresso</class>
        <class>org.hexanet.eventhub.model.Organizador</class>
        <class>org.hexanet.eventhub.model.Pagamento</class>
        <class>org.hexanet.eventhub.model.Participante</class>
        <class>org.hexanet.eventhub.model.Pedido</class>


        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver" />

            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/eventhub?createDatabaseIfNotExist=true&amp;useTimezone=true&amp;serverTimezone=UTC" />

            <property name="jakarta.persistence.jdbc.user" value="root" />
            <property name="jakarta.persistence.jdbc.password" value="ifsp" />

            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect" />

            <property name="hibernate.show_sql" value="true" />
            <property name="hibernate.format_sql" value="true" />
            <property name="hibernate.hbm2ddl.auto" value="update" />
        </properties>
    </persistence-unit>
</persistence>