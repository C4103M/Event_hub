<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="720.0" prefWidth="1080.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.hexanet.eventhub.controller.AuthController">
   <stylesheets>
      <URL value="@../styles.css" />
   </stylesheets>
   <children>
      <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
         <content>
            <StackPane style="-fx-padding: 20 0 20 0;">
               <children>
                  <VBox alignment="CENTER" maxWidth="450.0" prefWidth="450.0" spacing="15.0" styleClass="card">
                     <children>
                        <VBox alignment="CENTER" spacing="5.0">
                           <children>
                              <Label styleClass="label-title" text="Crie sua conta" />
                              <Label styleClass="label-subtitle" text="Selecione o tipo de conta para começar." />
                           </children>
                        </VBox>

                        <!-- Tipo de Conta -->
                        <HBox alignment="CENTER" spacing="25.0">
                           <children>
                              <RadioButton fx:id="rbParticipante" onAction="#toogleOrgPart" selected="true" text="Participante">
                                 <toggleGroup>
                                    <ToggleGroup fx:id="tgTipoUsuario" />
                                 </toggleGroup>
                              </RadioButton>
                              <RadioButton fx:id="rbOrganizador" onAction="#toogleOrgPart" text="Organizador" toggleGroup="$tgTipoUsuario" />
                           </children>
                        </HBox>

                        <!-- Nome -->
                        <VBox maxWidth="350.0" prefWidth="350.0" spacing="6.0">
                           <children>
                              <Label text="Nome Completo" />
                              <TextField fx:id="txtNome" promptText="Digite seu nome completo" onAction="#cadastrar" />
                           </children>
                        </VBox>

                        <!-- E-mail -->
                        <VBox maxWidth="350.0" prefWidth="350.0" spacing="6.0">
                           <children>
                              <Label text="E-mail" />
                              <TextField fx:id="txtEmail" promptText="Digite seu e-mail" onAction="#cadastrar" />
                           </children>
                        </VBox>

                        <HBox maxWidth="350.0" prefWidth="350.0" spacing="10.0">
                           <children>
                              <!-- CPF ou CNPJ Dinâmico -->
                              <VBox fx:id="vboxCpfCnpj" HBox.hgrow="ALWAYS" spacing="6.0" prefWidth="170.0">
                                 <children>
                                    <Label fx:id="lblCpfCnpj" text="CPF" />
                                    <TextField fx:id="txtCpfCnpj" promptText="Digite seu CPF" onAction="#cadastrar" />
                                 </children>
                              </VBox>

                              <!-- Data de Nascimento Dinâmico (Apenas para Participante) -->
                              <VBox fx:id="vboxDataNasc" HBox.hgrow="ALWAYS" spacing="6.0" prefWidth="170.0">
                                 <children>
                                    <Label text="Data de Nascimento" />
                                    <DatePicker fx:id="dpDataNasc" maxWidth="Infinity" promptText="DD/MM/AAAA" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                        <!-- Senha -->
                        <VBox maxWidth="350.0" prefWidth="350.0" spacing="6.0">
                           <children>
                              <Label text="Senha" />
                              <StackPane alignment="CENTER_LEFT">
                                 <children>
                                    <PasswordField fx:id="txtSenha" promptText="Crie uma senha de acesso" onAction="#cadastrar" />
                                    <TextField fx:id="txtSenhaRevelada" promptText="Crie uma senha de acesso" visible="false" managed="false" onAction="#cadastrar" />
                                 </children>
                              </StackPane>
                              <CheckBox fx:id="chkMostrarSenha" text="Mostrar Senha" onAction="#toogleMostrarSenha" style="-fx-font-size: 11px; -fx-text-fill: #4B5563;" />
                           </children>
                        </VBox>

                        <Label fx:id="lblMensagem" alignment="CENTER" maxWidth="350.0" styleClass="label-error" textAlignment="CENTER" wrapText="true" />

                        <!-- Ações -->
                        <VBox alignment="CENTER" maxWidth="350.0" prefWidth="350.0" spacing="12.0">
                           <children>
                              <Button fx:id="btnCadastrar" mnemonicParsing="false" onAction="#cadastrar" prefWidth="350.0" text="Cadastrar" />
                              <HBox alignment="CENTER" spacing="10.0">
                                 <children>
                                    <Label styleClass="label-subtitle" text="Já tem uma conta?" />
                                    <Button fx:id="btnIrParaLogin" mnemonicParsing="false" onAction="#irParaLogin" styleClass="button-secondary" text="Entrar" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </StackPane>
         </content>
      </ScrollPane>
   </children>
</StackPane>
