<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" styleClass="root" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.hexanet.eventhub.controller.PagamentoController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>

        <VBox maxWidth="600.0" spacing="25.0" styleClass="card">
            <children>

                <VBox spacing="5.0">
                    <children>
                        <Label styleClass="label-title" text="Finalizar Compra" />
                        <Label styleClass="label-subtitle" text="Revise seus ingressos e escolha o método de pagamento." />
                    </children>
                </VBox>

                <VBox spacing="10.0">
                    <children>
                        <Label style="-fx-font-weight: bold;" styleClass="label" text="Resumo do Pedido" />
                        <TableView fx:id="tvResumoItens" prefHeight="150.0" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="colIngressoNome" prefWidth="350.0" text="Tipo de Ingresso" />
                                <TableColumn fx:id="colIngressoPreco" minWidth="0.0" prefWidth="150.0" text="Preço Unitário" />
                                <TableColumn fx:id="colIngressoQtd" minWidth="0.0" prefWidth="150.0" text="Quantidade" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

                <VBox spacing="12.0">
                    <children>
                        <Label style="-fx-font-weight: bold;" styleClass="label" text="Selecione o Método de Pagamento" />

                        <HBox spacing="20.0" alignment="CENTER_LEFT">
                            <children>
                                <RadioButton fx:id="rbPix" userData="PIX" mnemonicParsing="false" selected="true" styleClass="radio-button" text="PIX">
                                    <toggleGroup>
                                        <ToggleGroup fx:id="grupoPagamento" />
                                    </toggleGroup>
                                </RadioButton>
                                <RadioButton fx:id="rbCredito" userData="CREDITO" mnemonicParsing="false" styleClass="radio-button" text="Cartão de Crédito" toggleGroup="$grupoPagamento" />
                                <RadioButton fx:id="rbDebito" userData="DEBITO" mnemonicParsing="false" styleClass="radio-button" text="Cartão de Débito" toggleGroup="$grupoPagamento" />
                                <RadioButton fx:id="rbBoleto" userData="BOLETO" mnemonicParsing="false" styleClass="radio-button" text="Boleto" toggleGroup="$grupoPagamento" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="20.0" style="-fx-padding: 10 0 0 0;">
                    <children>
                        <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="label-subtitle" text="Total a pagar:" />
                                <Label fx:id="lblValorTotal" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1E3A8A;" text="R$ 0,00" />
                            </children>
                        </VBox>

                        <Button mnemonicParsing="false" styleClass="button-secondary" text="Voltar" />
                        <Button mnemonicParsing="false"  styleClass="button" text="Confirmar Compra" onAction="#confirmarPagamento" />
                    </children>
                </HBox>

            </children>
        </VBox>

    </children>
</VBox>